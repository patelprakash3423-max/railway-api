HOST=0.0.0.0
PORT=4000
# Comma-separated exact origins; keep only the production frontend on Render.
CORS_ORIGIN=http://localhost:3000,https://railway-website-sage.vercel.app
LOCAL_RAILWAY_DB_PATH=data/local-railway/railway.sqlite
RAILWAY_DB_ASSET_URL=
RAILWAY_DB_SHA256=
RAILKIT_REQUEST_TIMEOUT_MS=15000
RAILKIT_AVAILABILITY_MAX_CONCURRENT=2
RAILKIT_AVAILABILITY_CACHE_TTL_MS=15000
RAILKIT_AVAILABILITY_CACHE_MAX_ENTRIES=500
# Exact-request unsupported evidence only; maximum TTL 86400000, entries 10000.
RAILKIT_UNSUPPORTED_CACHE_TTL_MS=900000
RAILKIT_UNSUPPORTED_CACHE_MAX_ENTRIES=1000
MAX_BOOKING_HORIZON_DAYS=60
SEARCH_RATE_LIMIT_MAX=5
SEARCH_RATE_LIMIT_WINDOW_MS=600000
# Keep ANONYMOUS for Render, NAT, proxies and shared localhost clients.
# DIRECT_PEER requires a controlled direct-only boundary with distinct peers.
SEARCH_CLIENT_IDENTITY_MODE=ANONYMOUS
SEARCH_MAX_CONCURRENT_PER_CLIENT=1
SEARCH_MAX_CONCURRENT_GLOBAL=3
RAILKIT_MONTHLY_REQUEST_LIMIT=10000
RAILKIT_BURST_REQUEST_LIMIT=120
RAILKIT_BURST_WINDOW_MINUTES=10
ENABLE_API_DIAGNOSTICS=false
EXPOSE_SEARCH_DIAGNOSTICS=false

# Application safety ceiling per V2 search; integer 1..500. Provider quotas remain independent.
JOURNEY_AVAILABILITY_PROVIDER_CALL_LIMIT=500

# Separate writable runtime state; never point this at LOCAL_RAILWAY_DB_PATH.
AVAILABILITY_STATE_DB_PATH=data/availability-state/observations.sqlite
AVAILABILITY_STATE_MAX_ROWS=100000
AVAILABILITY_STATE_RETENTION_MS=604800000
AVAILABILITY_STATE_BUSY_TIMEOUT_MS=25
# Freshness relative to boarding-date midnight in Asia/Kolkata.
AVAILABILITY_FRESHNESS_OVER_30_DAYS_MS=43200000
AVAILABILITY_FRESHNESS_OVER_15_DAYS_MS=21600000
AVAILABILITY_FRESHNESS_OVER_7_DAYS_MS=10800000
AVAILABILITY_FRESHNESS_OVER_2_DAYS_MS=3600000
AVAILABILITY_FRESHNESS_NEAR_MS=1800000

# Optional Redis >=6.2 evidence cache; disabled unless explicitly enabled.
REDIS_ENABLED=false
REDIS_URL=
# Per operation, including lazy connection; 1..1000 ms. No offline queue/retries.
REDIS_OPERATION_TIMEOUT_MS=150
# Failed connections/commands retry on later demand, after 1..60000 ms cooldown.
REDIS_RETRY_COOLDOWN_MS=1000

# Selected-journey maximum NEW calls = clamp(base + stops * per-stop, min, max).
# Count endpoints per traversed leg. The stricter global limit above still wins.
SELECTED_ROUTE_PROVIDER_CALL_BASE=20
SELECTED_ROUTE_PROVIDER_CALLS_PER_STOP=6
SELECTED_ROUTE_PROVIDER_CALL_MIN=60
SELECTED_ROUTE_PROVIDER_CALL_MAX=500
# Optional test/development override; leave unset for dynamic production budgeting.
# SELECTED_ROUTE_AVAILABILITY_PROVIDER_CALL_LIMIT=40
