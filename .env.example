HOST=0.0.0.0
PORT=4000
# Comma-separated exact origins; keep only the production frontend on Render.
CORS_ORIGIN=http://localhost:3000,https://railway-website-sage.vercel.app
LOCAL_RAILWAY_DB_PATH=data/local-railway/railway.sqlite
RAILWAY_DB_ASSET_URL=
RAILWAY_DB_SHA256=
RAILKIT_REQUEST_TIMEOUT_MS=15000
RAILKIT_AVAILABILITY_MAX_CONCURRENT=2
RAILKIT_AVAILABILITY_CACHE_TTL_MS=15000
RAILKIT_AVAILABILITY_CACHE_MAX_ENTRIES=500
# Exact-request unsupported evidence only; maximum TTL 86400000, entries 10000.
RAILKIT_UNSUPPORTED_CACHE_TTL_MS=900000
RAILKIT_UNSUPPORTED_CACHE_MAX_ENTRIES=1000
JOURNEY_SEARCH_TIMEOUT_MS=90000
MAX_BOOKING_HORIZON_DAYS=60
SEARCH_RATE_LIMIT_MAX=5
SEARCH_RATE_LIMIT_WINDOW_MS=600000
# Keep ANONYMOUS for Render, NAT, proxies and shared localhost clients.
# DIRECT_PEER requires a controlled direct-only boundary with distinct peers.
SEARCH_CLIENT_IDENTITY_MODE=ANONYMOUS
SEARCH_MAX_CONCURRENT_PER_CLIENT=1
SEARCH_MAX_CONCURRENT_GLOBAL=3
RAILKIT_MONTHLY_REQUEST_LIMIT=10000
RAILKIT_BURST_REQUEST_LIMIT=120
RAILKIT_BURST_WINDOW_MINUTES=10
ENABLE_API_DIAGNOSTICS=false
EXPOSE_SEARCH_DIAGNOSTICS=false
