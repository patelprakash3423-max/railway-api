{
  "name": "railway-api",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./src/test-support/local-network-only.mjs --import tsx --test src/tests/*.test.ts src/local-railway/tests/*.test.ts scripts/*.test.mjs",
    "dev:api": "node --watch --import tsx src/api/main.ts",
    "start:api": "npm start",
    "railway:import": "node --import tsx src/local-railway/cli.ts import",
    "railway:import:fixture": "node --import tsx src/local-railway/cli.ts import --trains src/local-railway/tests/fixtures/trains.csv --stops src/local-railway/tests/fixtures/stops.csv --stations src/local-railway/tests/fixtures/stations.csv --label SYNTHETIC_TEST_FIXTURE",
    "railway:plan": "node --import tsx src/local-railway/cli.ts plan",
    "test:local-railway": "node --import tsx --test src/local-railway/tests/*.test.ts",
    "railway:plan:v2": "node --import tsx src/local-railway/planner/v2/cli.ts",
    "railway:availability:v2": "node --import tsx src/journey/availability/cli.ts",
    "railway:recover:v2": "node --import tsx src/journey/availability/recovery/cli.ts",
    "railway:journey:v2": "node --import tsx src/journey/availability/journey/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/main.js",
    "provision:db": "node scripts/provision-railway-db.mjs",
    "prestart": "npm run provision:db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "RailKit playground and normalized railway provider",
  "dependencies": {
    "dotenv": "^17.4.2",
    "railkit": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
